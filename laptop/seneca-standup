#!/bin/bash
# The laptop half of Seneca's morning standup.
#
# Runs what /daily-standup runs — collect.sh, then opencode with the skill's own
# rules — headless, and hands the finished summary to the server's
# standup-intake over ssh. seneca-standup.timer starts it on weekdays at 07:00.
# Every SENECA_* variable below may be overridden from the environment.
set -uo pipefail

COLLECT="${SENECA_COLLECT:-$HOME/.claude/skills/daily-standup/scripts/collect.sh}"
SKILL="${SENECA_SKILL:-$HOME/.claude/skills/daily-standup/SKILL.md}"
HOST="${SENECA_HOST:-server}"
INTAKE="${SENECA_INTAKE:-/home/openclaw/bin/standup-intake}"
OPENCODE="${SENECA_OPENCODE:-opencode}"
MODEL="${SENECA_MODEL:-proxy/gpt-6.1-sol}"
OPENCODE_TIMEOUT="${SENECA_OPENCODE_TIMEOUT:-600}"
NOTIFY="${SENECA_NOTIFY:-notify-send}"
SSH="${SENECA_SSH:-ssh}"
DATE="${SENECA_DATE:-$(TZ=Asia/Tomsk date +%F)}"
STATE="${SENECA_STATE_HELPER:-$HOME/.local/bin/pantheon-state}"
STATE_DIR="${SENECA_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pantheon}"
MODE="${1:-}"
case "$MODE" in ''|--resume|--resend|--status) ;; *) echo 'usage: seneca-standup [--status|--resume|--resend]' >&2; exit 2;; esac
READY=0
stage() { "$STATE" --state-dir "$STATE_DIR" local-stage "$DATE" "$@"; }

fail() { # $1 the step that failed, $2 the full detail
  if [ "$READY" -eq 1 ]; then
    stage failed --category "$1" || true
  fi
  echo "seneca-standup: $1 failed:" >&2
  printf '%s\n' "$2" >&2
  "$NOTIFY" -a Seneca -u critical "Сенека: стендап не отправлен — $1" \
    "$(printf '%s\n' "$2" | tail -n 3)" || true
  exit 1
}

stdout_tail() { # $1 a file: what its producer said on stdout, if anything
  [ -s "$1" ] || return 0
  printf '\nstdout:\n%s\n' "$(tail -n 5 "$1")"
}

[[ "$DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && [ "$(date -d "$DATE" +%F 2>/dev/null)" = "$DATE" ] && DOW="$(date -d "$DATE" +%u 2>/dev/null)" \
  || fail date "not a date: $DATE"
if [ "$MODE" = --status ]; then
  exec "$STATE" --state-dir "$STATE_DIR" status "$DATE"
fi
umask 077
WORK="$STATE_DIR/standups/$DATE"
mkdir -p "$WORK" || fail tmp 'cannot create durable work directory'
chmod 700 "$STATE_DIR" "$STATE_DIR/standups" "$WORK"
exec 9> "$WORK/.laptop-lock"
flock -x 9 || fail tmp 'cannot lock date'
READY=1
if [ -s "$WORK/summary" ] && [ -z "$MODE" ]; then
  echo 'seneca-standup: recorded attempt; use --status or explicit --resume (no automatic resend)'
  exec "$STATE" --state-dir "$STATE_DIR" status "$DATE"
fi
stage started || fail tmp 'cannot persist start'
if [ "$DOW" = 1 ]; then
  WINDOW=3d
  HEADING="За 3 дня"
else
  WINDOW=1d
  HEADING="За последние 24 часа"
fi

if [ "$MODE" != --resume ] && [ "$MODE" != --resend ]; then
stage started --window "$WINDOW" || fail tmp 'cannot persist collection window'
rc=0
"$COLLECT" "$WINDOW" > "$WORK/collected" 2> "$WORK/collect.err" || rc=$?
[ "$rc" -eq 0 ] || fail collect "rc=$rc; $(cat "$WORK/collect.err")"
stage collected || fail tmp 'cannot persist collection completion'

rc=0
cat "$SKILL" > "$WORK/skill.body" 2> "$WORK/skill.err" || rc=$?
[ "$rc" -eq 0 ] || fail skill "rc=$rc; $(cat "$WORK/skill.err")"

(
  set -e
  {
    cat <<EOF
You are running unattended as a scheduled job; nobody will read questions or answer them.
collect.sh has already run for the window $WINDOW and its output is below — do not run anything.
Write the standup summary strictly by the rules of the daily-standup skill that follows, under the heading «$HEADING».
Output only the summary itself: no preamble, no questions, no offers to widen the window.

===== daily-standup SKILL.md =====
EOF
    cat "$WORK/skill.body"
    printf '\n===== collect.sh output =====\n'
    cat "$WORK/collected"
  } > "$WORK/prompt"
) 2> "$WORK/prompt.err"
rc=$?
[ "$rc" -eq 0 ] || fail prompt "$(cat "$WORK/prompt.err")"

rc=0
timeout "$OPENCODE_TIMEOUT" "$OPENCODE" run --model "$MODEL" --standalone \
  < "$WORK/prompt" > "$WORK/summary.new" 2> "$WORK/opencode.err" || rc=$?
[ "$rc" -eq 0 ] || fail opencode "rc=$rc; $(cat "$WORK/opencode.err")$(stdout_tail "$WORK/summary.new")"
grep -q '[^[:space:]]' "$WORK/summary.new" || fail summary "opencode returned an empty summary"
[ "$(wc -c < "$WORK/summary.new")" -le 65536 ] || fail summary 'summary exceeds 65536 bytes'
mv "$WORK/summary.new" "$WORK/summary"
stage generated || fail tmp 'cannot persist generation completion'
fi
[ -s "$WORK/summary" ] || fail summary 'no stored summary to resume'

stage submitting || fail tmp 'cannot persist submission attempt'
REMOTE_FLAGS=()
if [ "$MODE" = --resend ]; then
  echo 'warning: explicit resend may duplicate an unknown prior outcome' >&2
  REMOTE_FLAGS=(--resend)
fi
: > "$WORK/ssh.all.err"
while :; do
  rc=0
  "$SSH" -o BatchMode=yes -o ConnectTimeout=20 "$HOST" "$INTAKE" "$DATE" "${REMOTE_FLAGS[@]}" \
    < "$WORK/summary" > "$WORK/intake.out" 2> "$WORK/ssh.err" || rc=$?
  [ "$rc" -eq 0 ] && break
  { echo "attempt 1 rc=$rc"; cat "$WORK/ssh.err"; } >> "$WORK/ssh.all.err"
  if [ "$rc" -eq 255 ]; then
    stage submission_unknown || true
    fail ssh "unknown remote outcome; --resume reuses the stored summary and server deduplication. $(cat "$WORK/ssh.all.err")"
  fi
  fail intake "rc=$rc; $(cat "$WORK/ssh.all.err")"
done
stage submitted || fail tmp 'cannot persist submission completion'
# SSH exit zero establishes submission, not native processing or a platform send.
echo "seneca-standup: submitted $DATE (window $WINDOW); inspect server processing/delivery receipt"

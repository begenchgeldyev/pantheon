#!/bin/bash
# Shared helpers for the remind* implementations. Sourced, not executed.
#
# Attribution note: the agent id is NEVER derived from the environment. The
# working directory, the environment and even OpenClaw's exec `workdir` are
# caller-controlled, so an agent could spoof any of them. The id is passed as
# the first argument by a wrapper script that lives in a directory only that
# one agent is allowed to exec (per-agent approvals allowlist) and hard-codes
# its id — the allowlist is the only unforgeable part of the chain.
#
# Delivery: reminders are cron command jobs announced over OpenClaw's own
# Telegram channel. The chat id is derived from the agent id: u_<id> resolves
# to <id>; owner agents (main and the gods) read the numeric chat id from the
# owner-chat file installed next to this lib by hand (never from the
# environment).

export PATH=/usr/local/bin:/usr/bin:/bin:/home/openclaw/.openclaw/tools/node/bin

PANTHEON_IMPL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

pantheon_check_agent() { # $1 agent id (covers main, u_<id>, owner gods)
  [[ "$1" =~ ^[a-z][a-z0-9_]{0,63}$ ]] && return 0
  echo "remind: invalid agent id: $1" >&2
  return 3
}

# Job-name slugs become part of the cron job name; keep them boring.
pantheon_check_name() { # $1 name
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] && return 0
  echo "remind: invalid job name: $1 (expected [a-z0-9][a-z0-9-]{0,63})" >&2
  return 2
}

# Resolve the Telegram chat id that a reminder for agent $1 is delivered to.
pantheon_chat_for_agent() { # $1 agent id
  local id="$1" chat
  if [[ "$id" =~ ^u_([0-9]+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  local file="$PANTHEON_IMPL_DIR/owner-chat"
  [ -r "$file" ] || { echo "remind: no owner chat configured ($file)" >&2; return 5; }
  chat=$(head -n 1 "$file")
  [[ "$chat" =~ ^[0-9]+$ ]] || { echo "remind: owner chat is not a numeric id ($file)" >&2; return 5; }
  printf '%s\n' "$chat"
}

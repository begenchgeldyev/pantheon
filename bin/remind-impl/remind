#!/bin/bash
set -euo pipefail

. "$(dirname "$(readlink -f "$0")")/remind-lib"
if [ "$#" -lt 4 ]; then
  echo "usage: remind <agent-id> <iso-timestamp> <job-name> <message text...>" >&2
  exit 2
fi
AGENT="$1"; shift
pantheon_check_agent "$AGENT"
AT="$1"; NAME="$2"; shift 2; MSG="$*"
# Validate before touching openclaw: no argument may look like a flag.
if [[ ! "$AT" =~ ^[0-9] ]]; then
  echo "usage: remind <agent-id> <iso-timestamp> <job-name> <message text...> (timestamp must start with a digit, got: $AT)" >&2
  exit 2
fi
pantheon_check_name "$NAME"
[ -n "$MSG" ] || { echo "remind: empty message" >&2; exit 2; }
CHAT="$(pantheon_chat_for_agent "$AGENT")"
exec openclaw cron add --name="${AGENT}--${NAME}" --agent="$AGENT" --at="$AT" \
  --command-argv='["/bin/cat"]' --command-input="$MSG" \
  --announce --channel=telegram --to="$CHAT" --delete-after-run

#!/bin/bash
# Schedule a one-shot reminder at a specific time.
# Usage: remind <agent-id> <ISO-8601 timestamp> <job-name-slug> <message text>
# Called through a per-agent wrapper that supplies <agent-id>.
set -euo pipefail
# Explicit PATH: the inherited one is caller-controlled and must not decide
# which curl/jq/openclaw we run.
export PATH=/usr/local/bin:/usr/bin:/bin:/home/openclaw/.openclaw/tools/node-v24.15.0/bin
. "$(dirname "$(readlink -f "$0")")/remind-lib"
if [ "$#" -lt 4 ]; then
  echo "usage: remind <agent-id> <iso-timestamp> <job-name> <message text...>" >&2
  exit 2
fi
AGENT="$1"; shift
pantheon_check_agent "$AGENT"
AT="$1"; NAME="$2"; shift 2; MSG="$*"
# Validate before touching openclaw: no argument may look like a flag.
if [[ ! "$AT" =~ ^[0-9] ]]; then
  echo "usage: remind <agent-id> <iso-timestamp> <job-name> <message text...> (timestamp must start with a digit, got: $AT)" >&2
  exit 2
fi
pantheon_check_name "$NAME"
openclaw cron add "${AGENT}--${NAME}" --agent "$AGENT" --at "$AT" \
  --command "$NOTIFY_CMD" \
  --command-input "$(notify_body "$AGENT" "$MSG")" \
  --delete-after-run --best-effort-deliver

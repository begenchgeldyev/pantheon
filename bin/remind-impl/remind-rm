#!/bin/bash
# Cancel a reminder by its job name (without the agent prefix).
# Usage: remind-rm <agent-id> <job-name-slug>   (agent id from the wrapper)
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/remind-lib"
if [ "$#" -ne 2 ]; then echo "usage: remind-rm <agent-id> <job-name>" >&2; exit 2; fi
AGENT="$1"; NAME="$2"
pantheon_check_agent "$AGENT"
pantheon_check_name "$NAME"
ID=$(openclaw cron list --json | jq -r --arg n "${AGENT}--${NAME}" '.jobs[] | select(.name == $n) | .id' | head -1)
if [ -z "$ID" ]; then echo "no reminder named: $NAME" >&2; exit 4; fi
openclaw cron rm "$ID"

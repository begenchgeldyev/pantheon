#!/bin/bash
set -eou pipefail

. "$(dirname "$(readlink -f "$0")")/remind-lib"
if [ "$#" -lt 3 ]; then
    echo "usage: tell <from-agent-id> <to-god-id> <message text...>" >&2
    exit 2
fi
FROM="$1"; TO="$2"; shift 2; MSG="$*"

pantheon_check_agent "$FROM"
pantheon_check_agent "$TO"

if [ "$FROM" = "$TO" ]; then
    echo "tell: a god does not send word to itself ($FROM)" >&2
    exit 2
fi

if [ -z "$MSG" ]; then
    echo "tell: empty message" >&2
    exit 2
fi

if [ "${#MSG}" -gt 1500 ]; then
    echo "tell: message too long (${#MSG} chars, max 1500)" >&2
    exit 2
fi

SECRET="${PANTHEON_NOTIFY_SECRET:-}"
if [ -z "$SECRET" ]; then
    SECRET_FILE="${PANTHEON_SECRET_FILE:-$HOME/.openclaw/pantheon-notify-secret}"
    if [ ! -r "$SECRET_FILE" ]; then
        echo "tell: no notify secret (env unset and $SECRET_FILE unreachable)" >&2
        exit 4
    fi
    SECRET="$(cat "$SECRET_FILE")"
fi

jq -nc --arg f "$FROM" --arg t "$TO" --arg x "$MSG" '{from:$f,to:$t,text:$x}' \
| curl -sf -X POST "http://${NOTIFY_HOST:-127.0.0.1}:${NOTIFY_PORT:-8477}/tell" \
    -H "X-Pantheon-Secret: $SECRET" -H "Content-Type: application/json" -d @- \
|| { echo "tell: word did not arrive (server refused or unreachable)" >&2; exit 5; }

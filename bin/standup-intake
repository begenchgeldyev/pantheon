#!/bin/bash
# Receive the owner's standup and request Seneca formatting and sending.
#
# Usage: standup-intake <YYYY-MM-DD>   (the finished summary on stdin)
#
# The laptop job (laptop/seneca-standup) runs this over ssh. The summary is
# stored in Seneca's workspace as standups/<date>.md. One turn of
# agent:seneca:main formats only the provided summary per AGENTS.md and replies
# only with that summary. Sending is requested; processing and send outcomes
# are separately observed, never inferred from a successful process exit.
set -euo pipefail

. "$(dirname "$(readlink -f "$0")")/remind-impl/remind-lib"

WORKSPACE="${PANTHEON_WORKSPACE:-/home/openclaw/.openclaw/workspace-seneca}"
STATE="$(dirname "$(readlink -f "$0")")/pantheon-state"
OPENCLAW_USER="${PANTHEON_OPENCLAW_USER:-openclaw}"
OPENCLAW_HOME="${PANTHEON_OPENCLAW_HOME:-/home/openclaw}"
RUNUSER="${PANTHEON_RUNUSER:-$(command -v runuser || true)}"
# remind-lib keeps /usr/sbin off PATH, and that is where runuser lives
if [ -z "$RUNUSER" ] && [ -x /usr/sbin/runuser ]; then
  RUNUSER=/usr/sbin/runuser
fi

if [ "$#" -lt 1 ]; then
  echo "usage: standup-intake <YYYY-MM-DD> [--resume] [--replace --resend] < summary" >&2
  exit 2
fi
DATE="$1"; shift
if [[ ! "$DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || [ "$(date -d "$DATE" +%F 2>/dev/null)" != "$DATE" ]; then
  echo "standup-intake: not a calendar date: $DATE" >&2
  exit 2
fi

if [ ! -d "$WORKSPACE" ]; then
  echo "standup-intake: no Seneca workspace at $WORKSPACE" >&2
  exit 4
fi
CHAT="$(pantheon_chat_for_agent seneca)"
EXEC=(--exec-arg=openclaw)
OWNER=()
if [ "$(id -u)" -eq 0 ] && id -u "$OPENCLAW_USER" >/dev/null 2>&1; then
  # Never silently execute a root-owned agent when runuser is unavailable.
  [ -x "$RUNUSER" ] || { echo 'standup-intake: runuser unavailable' >&2; exit 4; }
  EXEC=("--exec-arg=$RUNUSER" --exec-arg=-u "--exec-arg=$OPENCLAW_USER" --exec-arg=-- \
    --exec-arg=env "--exec-arg=HOME=$OPENCLAW_HOME" --exec-arg=openclaw)
  OWNER=(--owner "$(id -u "$OPENCLAW_USER"):$(id -g "$OPENCLAW_USER")")
fi
exec "$STATE" intake "$DATE" --workspace "$WORKSPACE" --chat "$CHAT" "${OWNER[@]}" "${EXEC[@]}" "$@"

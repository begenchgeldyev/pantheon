{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": { "mode": "token", "token": "${OPENCLAW_GATEWAY_TOKEN}" }
  },
  "channels": { "telegram": { "enabled": false } },
  "cron": { "enabled": false, "triggers": { "enabled": false } },
  "update": { "checkOnStart": false },
  "discovery": { "mdns": { "mode": "off" } },
  "agents": { "defaults": { "heartbeat": { "every": "0m" } } }
}

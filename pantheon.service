# DEPRECATED as of 2026-08-22.
#
# Pantheon now runs as a Docker container managed by docker compose.
# See docker-compose.yml at the repo root and the deploy section of README.md.
#
# This unit file is kept in-repo for reference only. It is NOT installed by the
# containerized deploy. If it is still enabled on a host, disable it before
# starting the container, or two Pantheon instances will fight over the
# Telegram bot token (long-polling conflict):
#     systemctl --user stop pantheon
#     systemctl --user disable pantheon
#     rm ~/.config/systemd/user/pantheon.service
#     systemctl --user daemon-reload

[Unit]
Description=Pantheon — Telegram gateway to OpenClaw
# Start after the network is actually up (Telegram long polling needs it).
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

# Pantheon MUST run as the same user as the OpenClaw gateway: it writes agent
# workspaces under that user's OpenClaw state dir (~/.openclaw/workspace-*) and
# mutates OpenClaw's config through the CLI. Adjust if your OpenClaw user has a
# different name.
User=openclaw
Group=openclaw

# Absolute path to the project checkout.
WorkingDirectory=/opt/pantheon

# Absolute path to the Bun binary. Find it on the VPS with:  which bun
# (e.g. /home/openclaw/.bun/bin/bun or /usr/local/bin/bun) and set it here.
ExecStart=/usr/local/bin/bun run src/index.ts

# Configuration is loaded from this file (contains the bot token and the notify
# secret). Keep it readable only by the service user:
#   chown openclaw:openclaw /opt/pantheon/.env && chmod 600 /opt/pantheon/.env
EnvironmentFile=/opt/pantheon/.env

# Restart automatically after unexpected failures, with a small backoff.
Restart=on-failure
RestartSec=3

# Send SIGTERM on stop so Pantheon can shut down grammY cleanly.
KillSignal=SIGTERM
TimeoutStopSec=15

# Logs go to the journal (structured JSON lines from Pantheon).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pantheon

# --- Basic hardening ---
# NoNewPrivileges is always safe. The stricter options below are commented out
# because Pantheon spawns the `openclaw` CLI, which may need to reach the local
# OpenClaw Gateway (e.g. a socket under /tmp) and must read/write OpenClaw state
# under /home/openclaw. Enable them one at a time and confirm OpenClaw still
# works before committing to them. ProtectHome in particular must stay off (or
# be paired with ReadWritePaths=/home/openclaw), since provisioning writes agent
# workspaces there.
NoNewPrivileges=true
# ProtectSystem=strict
# PrivateTmp=true
# ReadWritePaths=/opt/pantheon /home/openclaw/.openclaw

[Install]
WantedBy=multi-user.target

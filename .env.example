# Pantheon configuration. Copy to `.env` and fill in. Do NOT commit `.env`.

# --- Required ---

# Telegram bot token from @BotFather (SECRET).
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (NOT your @username). See README for how to get it.
TELEGRAM_ALLOWED_USER_ID=

# Agent used when you haven't selected one with /agent.
DEFAULT_AGENT=iris

# --- Optional ---

# Comma-separated list of agents Pantheon should know about (for /agents and
# /<agent> shortcuts). DEFAULT_AGENT is always included automatically.
OPENCLAW_AGENTS=iris

# OpenClaw CLI executable. Name on PATH or an absolute path. No secret here.
OPENCLAW_BIN=openclaw

# Hard timeout for a single OpenClaw turn, in seconds.
OPENCLAW_TIMEOUT_SECONDS=120

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

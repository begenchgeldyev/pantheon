# --- Required ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram usernames (without @) allowed to use the bot.
TELEGRAM_ALLOWED_USERNAMES=begench
# The username mapped to the pre-existing OpenClaw agent "main". Must be in the list above.
TELEGRAM_OWNER_USERNAME=begench
# Shared secret for the loopback notify endpoint (OpenClaw cron -> Pantheon -> Telegram).
# Generate with: openssl rand -hex 32
# The same value must be exported to the OpenClaw gateway as
# PANTHEON_NOTIFY_SECRET (openclaw.json -> env), or reminders get a 401.
NOTIFY_SECRET=

# --- Optional ---
OPENCLAW_BIN=openclaw
OPENCLAW_STATE_DIR=/home/openclaw/.openclaw
# Extra gods the owner may summon besides Hermes (comma list of agent ids), e.g. athena
PANTHEON_OWNER_GODS=
# The router/front-door god that dispatches to the others (agent id), e.g. zeus. Empty = no router.
PANTHEON_ROUTER=
# Groq API key for voice-note transcription (Whisper). Empty = voice disabled. Secret.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
# Piper TTS for voice replies (local, keyless). Empty = disabled.
PANTHEON_PIPER_BIN=
PANTHEON_PIPER_VOICES=/opt/piper/voices
OPENCLAW_TIMEOUT_SECONDS=120
PANTHEON_DATA_DIR=./data
# Where per-agent remind wrappers are installed (<binDir>/agents/<agent-id>/).
PANTHEON_BIN_DIR=/home/openclaw/bin
# Where the shared remind implementations live (the wrappers exec these).
REMIND_IMPL_DIR=/home/openclaw/bin/remind-impl
LOG_LEVEL=info
NOTIFY_HOST=127.0.0.1
NOTIFY_PORT=8477
